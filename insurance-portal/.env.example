# ===================================================================
# Supabase / PostgreSQL connection for the Insurance Portal
# ===================================================================
# Copy this file to ".env" and fill in the real password. Do NOT commit .env.
#
# Where to find these values:
#   Supabase Dashboard -> Project "Insurance_Portal"
#     -> Project Settings -> Database
#        - "Connection string" tab -> "JDBC" gives the full URL below
#        - "Database password" is the one you set when creating the project
#          (use "Reset database password" if you don't have it)
#
# How the app loads these:
#   application.properties reads SUPABASE_DB_URL / SUPABASE_DB_USER /
#   SUPABASE_DB_PASSWORD from the environment. Set them in your shell before
#   running, or configure them as run-configuration env vars in your IDE.

# --- Connection pooler (Supavisor), session mode - default, works over IPv4 ---
SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.rmpucaqbvbedwagtynrt
SUPABASE_DB_PASSWORD=your-database-password-here

# --- Alternative: direct connection (IPv6-only; times out on IPv4 networks) ---
# SUPABASE_DB_URL=jdbc:postgresql://db.rmpucaqbvbedwagtynrt.supabase.co:5432/postgres?sslmode=require
# SUPABASE_DB_USER=postgres
