# ===================================================================
# Insurance Portal - database connection
# ===================================================================
# This team shares ONE Supabase project. The connection URL and user below are
# already filled in - you only need to add the database PASSWORD.
#
# 1. Copy this file to ".env"   ->   cp .env.example .env
# 2. Put the shared database password in SUPABASE_DB_PASSWORD (ask the project
#    owner for it - it is NOT committed to the repo).
# 3. Run the app (see README). application.properties auto-loads this .env.
#
# ".env" is gitignored and must NEVER be committed.
#
# Note: everyone using this connection shares the same data.

SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.rmpucaqbvbedwagtynrt
SUPABASE_DB_PASSWORD=<ask the project owner for the password>

# --- Want to use your OWN Supabase project instead? Replace all three above ---
# SUPABASE_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# SUPABASE_DB_USER=postgres.<your-project-ref>
# SUPABASE_DB_PASSWORD=<your-database-password>
